# Explicit verification config. scripts/verify.sh refuses to run without it.
# Created from ai-repo-template v1.0.0. Release notes, including what to copy into a project
# made from an earlier version: https://github.com/ags911/ai-repo-template/releases

# Space-separated, no auto-detection. At least one stack: "ts", "python". Extras:
# "secrets" (gitleaks), "links" (lychee, offline), "adr" (adr module). For example
# "ts python secrets links".
VERIFY_PROFILES=""

# Where each profile's project root lives (monorepos: e.g. TS_DIR=web PY_DIR=agent)
TS_DIR="."
PY_DIR="."

# Directories that must exist for boundary checks to mean anything.
# Leave empty if you have not installed a boundaries module.
REQUIRED_DIRS=""

# pytest exits 5 when it collects no tests; that fails verify unless set to 1.
# Use only while bootstrapping a new repo.
ALLOW_EMPTY_TESTS=0

# Ref that check-suppressions.sh diffs against. An exported BASE_REF wins, so CI can
# set it per event (scripts/ci-base-ref.sh); this is the local default.
BASE_REF="${BASE_REF:-origin/main}"

# Port for the project's browser-test web server (Playwright's webServer, a dev server). Read
# it from the environment in the project's own config, e.g. in playwright.config.ts:
#   const port = Number(process.env.TEST_PORT ?? 3000);
# so two verify runs on one machine (two clones, two agent sessions) do not both claim 3000.
# Set it here, or in the environment, to fix the port. Left unset, a free one is picked, once
# per run, and exported so every profile sees the same value. Needs python3; without it
# TEST_PORT stays unset and the project's own default applies.
if [ -z "${TEST_PORT:-}" ]; then
  TEST_PORT=$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])' 2>/dev/null) || TEST_PORT=""
fi
if [ -n "$TEST_PORT" ]; then export TEST_PORT; else unset TEST_PORT; fi
