# Explicit verification config. scripts/verify.sh refuses to run without it.

# Space-separated, no auto-detection. Stacks: "ts", "python". Extras: "secrets" (gitleaks),
# "links" (lychee, offline). For example "ts python secrets links".
VERIFY_PROFILES=""

# Where each profile's project root lives (monorepos: e.g. TS_DIR=web PY_DIR=agent)
TS_DIR="."
PY_DIR="."

# Directories that must exist for boundary checks to mean anything.
# Leave empty if you have not installed a boundaries module.
REQUIRED_DIRS=""

# pytest exits 5 when it collects no tests; that fails verify unless set to 1.
# Use only while bootstrapping a new repo.
ALLOW_EMPTY_TESTS=0

# Ref that check-suppressions.sh diffs against. An exported BASE_REF wins, so CI can
# set it per event (scripts/ci-base-ref.sh); this is the local default.
BASE_REF="${BASE_REF:-origin/main}"
